rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public curriculum metadata — loaded before sign-in on the dashboard.
    match /topics/{topicId} {
      allow read: if true;
    }

    // Quiz content — public read; anyone can flag bad questions (deactivate only).
    match /questions/{questionId} {
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'ready'])
        && request.resource.data.active == false
        && request.resource.data.ready == false;
    }

    // Dimpo Accounting curriculum — public read for lessons.
    match /accounting_topics/{topicId} {
      allow read: if true;
    }

    match /accounting/{questionId} {
      allow read: if true;
    }

    // Per-user profile and progress.
    // Entitlement fields (premium / premiumUpdatedAt) are not client-writable.
    // Subscription access is determined by RevenueCat on the client; any server-side
    // premium mirror must come from a trusted backend (e.g. RevenueCat webhooks).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['premium', 'premiumUpdatedAt']);

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['premium', 'premiumUpdatedAt']);
    }
  }
}
